{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "devCommand": "cd frontend && npm run dev",
  "installCommand": "cd frontend && npm install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_API_BASE_URL": {
      "description": "Base URL for the backend API (e.g., https://api.yourdomain.com)",
      "required": true
    },
    "NEXT_PUBLIC_API_URL": {
      "description": "Full API URL including version path (e.g., https://api.yourdomain.com/api/v1)",
      "required": true
    },
    "NEXT_PUBLIC_WS_URL": {
      "description": "WebSocket URL for real-time chat (e.g., wss://api.yourdomain.com/ws/chat)",
      "required": true
    },
    "NEXT_PUBLIC_ENABLE_CACHE": {
      "description": "Enable caching functionality (true/false)",
      "value": "true"
    },
    "NEXT_PUBLIC_ENABLE_STREAMING": {
      "description": "Enable streaming responses (true/false)",
      "value": "true"
    },
    "NEXT_PUBLIC_ENABLE_DARK_MODE": {
      "description": "Enable dark mode support (true/false)",
      "value": "true"
    },
    "NEXT_PUBLIC_DEFAULT_MODEL": {
      "description": "Default AI model to use",
      "value": "gpt-3.5-turbo"
    },
    "NEXT_PUBLIC_DEFAULT_TEMPERATURE": {
      "description": "Default temperature for AI responses",
      "value": "0.7"
    },
    "NEXT_PUBLIC_MAX_TOKENS": {
      "description": "Maximum tokens for AI responses",
      "value": "2048"
    },
    "NEXT_PUBLIC_WS_RECONNECT_INTERVAL": {
      "description": "WebSocket reconnection interval in milliseconds",
      "value": "5000"
    },
    "NEXT_PUBLIC_WS_MAX_RECONNECT_ATTEMPTS": {
      "description": "Maximum WebSocket reconnection attempts",
      "value": "5"
    },
    "NEXT_PUBLIC_WS_HEARTBEAT_INTERVAL": {
      "description": "WebSocket heartbeat interval in milliseconds",
      "value": "30000"
    },
    "NEXT_PUBLIC_APP_NAME": {
      "description": "Application name displayed in UI",
      "value": "AI Chatbot System"
    },
    "NEXT_PUBLIC_THEME_COLOR": {
      "description": "Primary theme color",
      "value": "#000000"
    }
  }
}
