# ============================================
# Customer Support Assistant - Configuration
# ============================================

# ---------- Frontend Branding ----------
NEXT_PUBLIC_APP_NAME="Customer Support Assistant"
NEXT_PUBLIC_APP_SHORT_NAME="Support Chat"
NEXT_PUBLIC_LOGO_EMOJI="🎧"
NEXT_PUBLIC_TAGLINE="24/7 AI-Powered Customer Support"
NEXT_PUBLIC_COMPANY="Your Company Name"
NEXT_PUBLIC_FOOTER_TEXT="© Your Company Name"

# ---------- Theme ----------
NEXT_PUBLIC_PRIMARY_COLOR="green"
NEXT_PUBLIC_ACCENT_COLOR="blue"
NEXT_PUBLIC_THEME_MODE="light"

# ---------- Features ----------
NEXT_PUBLIC_ENABLE_MODEL_SELECTION="false"
NEXT_PUBLIC_ENABLE_STREAMING="true"
NEXT_PUBLIC_ENABLE_FILE_UPLOAD="true"
NEXT_PUBLIC_ENABLE_VOICE="false"
NEXT_PUBLIC_ENABLE_HISTORY="true"
NEXT_PUBLIC_MAX_MESSAGE_LENGTH="4000"

# ---------- API ----------
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_WS_URL="ws://localhost:8000/ws"
NEXT_PUBLIC_API_TIMEOUT="30000"

# ---------- Defaults ----------
NEXT_PUBLIC_DEFAULT_MODEL="gpt-4"
NEXT_PUBLIC_DEFAULT_TEMP="0.5"
NEXT_PUBLIC_DEFAULT_MAX_TOKENS="1500"

# ---------- UI ----------
NEXT_PUBLIC_SHOW_WELCOME="true"
NEXT_PUBLIC_WELCOME_MESSAGE="Hello! How can I help you today?"
NEXT_PUBLIC_PLACEHOLDER="Describe your issue or question..."
NEXT_PUBLIC_SHOW_MODEL_BADGE="false"
NEXT_PUBLIC_SHOW_TIMESTAMPS="true"

# ---------- Backend Configuration ----------
USE_CASE_NAME="Customer Support"
USE_CASE_DESCRIPTION="AI-powered customer support assistant"
DEFAULT_MODEL="gpt-4"
ALLOWED_MODELS="gpt-4,gpt-3.5-turbo"
RESPONSE_STYLE="professional"
MAX_RESPONSE_LENGTH="1500"

# ---------- Feature Flags ----------
ENABLE_WEB_SEARCH="false"
ENABLE_CODE_EXECUTION="false"
ENABLE_DOCUMENT_ANALYSIS="true"
ENABLE_IMAGE_GENERATION="false"
ENABLE_CONTENT_FILTERING="true"

# ---------- Integrations (Optional) ----------
ENABLE_SLACK_INTEGRATION="false"
ENABLE_DISCORD_INTEGRATION="false"
ENABLE_WEBHOOK_NOTIFICATIONS="false"

# ---------- Required API Keys ----------
# Add your API keys here
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
