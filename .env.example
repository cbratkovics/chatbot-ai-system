# ===========================================
# AI CHATBOT SYSTEM - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env for local development
# For production (Render), set these in the dashboard

# -----------------
# Application
# -----------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# -----------------
# Server
# -----------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
WORKERS=1

# -----------------
# AI Provider API Keys (REQUIRED)
# -----------------
OPENAI_API_KEY=sk-proj-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# -----------------
# Redis Cache (REQUIRED)
# -----------------
# Local: redis://localhost:6379/0
# Render: Get from Redis instance dashboard
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# -----------------
# Pinecone Vector Database (OPTIONAL)
# -----------------
# Get these from: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=chatbot-ai-system

# -----------------
# CORS (CRITICAL for production)
# -----------------
# Local development:
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Production (update with your domains):
# CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# -----------------
# Cache Configuration
# -----------------
CACHE_ENABLED=true
CACHE_TTL=300
SEMANTIC_CACHE_THRESHOLD=0.85

# -----------------
# Model Configuration
# -----------------
DEFAULT_MODEL=gpt-3.5-turbo
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2048
OPENAI_MODEL=gpt-3.5-turbo
ANTHROPIC_MODEL=claude-3-haiku-20240307

# -----------------
# Rate Limiting
# -----------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# -----------------
# WebSocket
# -----------------
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# -----------------
# Security
# -----------------
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -----------------
# Request Configuration
# -----------------
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_DELAY=1.0
MAX_RETRY_DELAY=10.0

# -----------------
# Database (OPTIONAL - not required for basic demo)
# -----------------
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# -----------------
# Feature Flags
# -----------------
ENABLE_STREAMING=true
ENABLE_SEMANTIC_CACHE=false
