# ===========================================
# AI CHATBOT SYSTEM - ENVIRONMENT VARIABLES
# ===========================================
# Copy to .env for local development. On Render, set these in the dashboard.
# Only ONE provider key is required. Everything else is optional and degrades
# gracefully: no Redis -> in-process cache, no Pinecone -> vector search stays off.

# -----------------
# Application
# -----------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=1

# -----------------
# AI Providers (at least one key REQUIRED)
# -----------------
# Primary: OpenAI gpt-4o-mini. Set a hard monthly spend limit in the OpenAI dashboard.
OPENAI_API_KEY=
# Fallback: Groq free tier via its OpenAI-compatible endpoint (no extra SDK).
GROQ_API_KEY=
# Optional third provider.
ANTHROPIC_API_KEY=

DEFAULT_MODEL=gpt-4o-mini
# Comma-separated provider:model pairs tried in order when the primary fails
# (401/402/429/5xx/timeout). Leave empty to disable failover.
FALLBACK_MODELS=groq:llama-3.1-8b-instant
ENABLE_FALLBACK=true
REQUEST_TIMEOUT=30
MAX_RETRIES=2

# -----------------
# Cache (OPTIONAL)
# -----------------
# Unset or unreachable REDIS_URL -> in-process LRU cache (same behaviour, per worker).
# REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_CONNECT_TIMEOUT_SECONDS=2
MEMORY_CACHE_MAX_ENTRIES=512
# TF-IDF similarity matching (loads scikit-learn). Off for the demo: exact-match only.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.85

# -----------------
# Demo guardrails (in-process, no database)
# -----------------
DEMO_GUARDRAILS_ENABLED=true
DEMO_RATE_LIMIT_PER_MINUTE=10
DEMO_RATE_LIMIT_PER_DAY=40
DEMO_MAX_TOKENS=400
DEMO_MAX_HISTORY_MESSAGES=8
DEMO_DAILY_TOKEN_BUDGET=150000
# Interview switch: when true, a request with header "X-Demo-Simulate-Failure: 1" makes the
# primary provider fail with a 503 so failover is visible. The UI shows a toggle only if true.
DEMO_FAILURE_TOGGLE_ENABLED=true
# Force the simulated outage for every request (no header needed). Leave false.
DEMO_SIMULATE_PRIMARY_FAILURE=false

# -----------------
# CORS (set to your Vercel domain in production)
# -----------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# -----------------
# Vector search (OPTIONAL, off by default; nothing imports Pinecone unless true)
# -----------------
ENABLE_VECTOR_SEARCH=false
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=chatbot-ai-system
# PINECONE_ENVIRONMENT=us-east-1

# -----------------
# Database (OPTIONAL, not used by the demo)
# -----------------
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot_db

# -----------------
# Legacy global rate limit (slowapi, all routes)
# -----------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
